+# Installed only where it is asked for: a build that takes it in as a part
+# of itself, its dependencies its own targets, has nothing of it to install,
+# and CMake checks an install(EXPORT) whether it runs or not.
+option(LIBDATACHANNEL_INSTALL "Install the library and its CMake package" ON)
+if(LIBDATACHANNEL_INSTALL)
 install(TARGETS datachannel EXPORT LibDataChannelTargets
 	RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR}
 	LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
