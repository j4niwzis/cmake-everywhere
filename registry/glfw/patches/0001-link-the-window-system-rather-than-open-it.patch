diff -ruN a/src/posix_module.c b/src/posix_module.c
--- a/src/posix_module.c
+++ b/src/posix_module.c
@@ -28,7 +28,40 @@
 
 #if defined(GLFW_BUILD_POSIX_MODULE)
 
-#include <dlfcn.h>
+#include <string.h>
+
+// The libraries this build has, and where they are.
+//
+// They are in the program. A build that links its window system rather than
+// opening it has nothing to open: every symbol this library asked a module
+// for is named directly, above, and what is left of loading a module is the
+// question of whether it is there at all.
+//
+// So a name this build linked answers yes, and every other name answers no,
+// which is the same answer the loader gave on a machine without it. That
+// matters: GLFW asks for libGL and for libGLESv2 to resolve GL entry points
+// by name, and in a build like this those come from the EGL that is linked
+// in, through eglGetProcAddress -- which is what GLFW does next when the
+// module is not there.
+static const char* const _glfwLinkedModules[] =
+{
+    "libwayland-client.so.0",
+    "libwayland-cursor.so.0",
+    "libwayland-egl.so.1",
+    "libxkbcommon.so.0",
+    "libX11.so.6",
+    "libX11-xcb.so.1",
+    "libXcursor.so.1",
+    "libXext.so.6",
+    "libXi.so.6",
+    "libXinerama.so.1",
+    "libXrandr.so.2",
+    "libEGL.so.1",
+    NULL
+};
+
+// One address, because a handle is only ever compared against NULL here.
+static int _glfwLinkedModuleHandle;
 
 //////////////////////////////////////////////////////////////////////////
 //////                       GLFW platform API                      //////
@@ -36,17 +69,22 @@
 
 void* _glfwPlatformLoadModule(const char* path)
 {
-    return dlopen(path, RTLD_LAZY | RTLD_LOCAL);
+    for (int i = 0;  _glfwLinkedModules[i];  i++)
+    {
+        if (strcmp(_glfwLinkedModules[i], path) == 0)
+            return &_glfwLinkedModuleHandle;
+    }
+
+    return NULL;
 }
 
 void _glfwPlatformFreeModule(void* module)
 {
-    dlclose(module);
 }
 
 GLFWproc _glfwPlatformGetModuleSymbol(void* module, const char* name)
 {
-    return dlsym(module, name);
+    return NULL;
 }
 
 #endif // GLFW_BUILD_POSIX_MODULE
