--- a/cmake/sdlchecks.cmake
+++ b/cmake/sdlchecks.cmake
@@ -644,12 +644,45 @@
   if(SDL_WAYLAND)
     set(WAYLAND_PKG_CONFIG_SPEC "wayland-client>=1.18" wayland-egl wayland-cursor egl "xkbcommon>=0.5.0")
     set(PC_WAYLAND_FOUND FALSE)
+    set(WAYLAND_FOUND FALSE)
+    # cmake-everywhere: Wayland, xkbcommon and EGL's headers built here, as
+    # ports: their targets, not pkg-config; the protocol code generated by
+    # the wayland port's scanner, built before it is run, not asked for its
+    # version now.
+    if(TARGET Wayland::client AND TARGET Wayland::egl AND TARGET Wayland::cursor AND TARGET Wayland::scanner
+       AND TARGET XKB::xkbcommon AND TARGET EGL::Headers)
+      if(NOT TARGET PkgConfig::PC_WAYLAND)
+        add_library(PkgConfig::PC_WAYLAND INTERFACE IMPORTED)
+        set_property(TARGET PkgConfig::PC_WAYLAND PROPERTY INTERFACE_LINK_LIBRARIES
+                     Wayland::client Wayland::egl Wayland::cursor XKB::xkbcommon EGL::Headers)
+      endif()
+      set(PC_WAYLAND_FOUND TRUE)
+      set(PC_WAYLAND_xkbcommon_VERSION "${CME_SDL_XKBCOMMON_VERSION}")
+      # The scanner runs on the build machine: in a cross build the
+      # machine's own (the port's is built for the target), else the port's.
+      if(CMAKE_CROSSCOMPILING AND TARGET cme_wayland_scanner_for_this_machine)
+        get_property(WAYLAND_SCANNER GLOBAL PROPERTY CME_WAYLAND_SCANNER_FOR_THIS_MACHINE)
+        function(_cme_sdl_after_scanner)
+          foreach(_cme_sdl IN ITEMS SDL3-static SDL3-shared SDL3_test)
+            if(TARGET ${_cme_sdl})
+              add_dependencies(${_cme_sdl} cme_wayland_scanner_for_this_machine)
+            endif()
+          endforeach()
+        endfunction()
+        cmake_language(DEFER CALL _cme_sdl_after_scanner)
+      elseif(CMAKE_CROSSCOMPILING)
+        find_program(WAYLAND_SCANNER NAMES wayland-scanner REQUIRED)
+      else()
+        set(WAYLAND_SCANNER "$<TARGET_FILE:Wayland::scanner>")
+      endif()
+      set(WAYLAND_FOUND TRUE)
+      set(WAYLAND_SCANNER_CODE_MODE "private-code")
+    else()
     if(PKG_CONFIG_FOUND)
       pkg_check_modules(PC_WAYLAND IMPORTED_TARGET ${WAYLAND_PKG_CONFIG_SPEC})
     endif()
     find_program(WAYLAND_SCANNER NAMES wayland-scanner)
 
-    set(WAYLAND_FOUND FALSE)
