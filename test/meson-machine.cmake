# Meson's compiler command must retain CMake's cross target, not just flags.
include("${CMAKE_CURRENT_LIST_DIR}/../cmake/mesonproject.cmake")
set(CMAKE_C_COMPILER "/tools/clang")
set(CMAKE_CXX_COMPILER "/tools/clang++")
set(CMAKE_C_COMPILER_ARG1 "--driver-mode=gcc")
set(CMAKE_CXX_COMPILER_ARG1 "--driver-mode=g++")
set(CMAKE_CROSSCOMPILING TRUE)
set(CMAKE_SYSTEM_NAME Android)
set(CMAKE_BUILD_TYPE Debug)
set(CMAKE_C_FLAGS "-mfpu=neon -mfloat-abi=softfp")
set(CMAKE_CXX_FLAGS "")
set(CMAKE_CXX_FLAGS_DEBUG "-O3 -g0")
set(CMAKE_SYSROOT "/android/sysroot")
foreach(triple armv7a-linux-androideabi28 aarch64-linux-android28)
  set(CMAKE_C_COMPILER_TARGET "${triple}")
  set(CMAKE_CXX_COMPILER_TARGET "${triple}")
  set(CMAKE_SYSTEM_PROCESSOR armv7-a)
  cme_meson_machine_file(test file kind)
  file(READ "${file}" machine)
  foreach(expected
      "c = ['/tools/clang', '--driver-mode=gcc', '--target=${triple}']"
      "cpp = ['/tools/clang++', '--driver-mode=g++', '--target=${triple}']"
      "cpp_args = ['-O3', '-g0', '--sysroot=/android/sysroot']"
      "system = 'android'")
    string(FIND "${machine}" "${expected}" found)
    if(found EQUAL -1)
      message(FATAL_ERROR "Missing ${expected}:\n${machine}")
    endif()
  endforeach()
  if(NOT kind STREQUAL cross)
    message(FATAL_ERROR "Not a cross file")
  endif()
endforeach()
unset(CMAKE_C_COMPILER_TARGET)
unset(CMAKE_CXX_COMPILER_TARGET)
set(CMAKE_CROSSCOMPILING FALSE)
cme_meson_machine_file(test file kind)
file(READ "${file}" machine)
if(NOT kind STREQUAL native OR machine MATCHES "--target=|host_machine")
  message(FATAL_ERROR "Cross compiler state leaked into native file:\n${machine}")
endif()
message(STATUS "Meson machine files preserve both target compilers and configuration flags")
