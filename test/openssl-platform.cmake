# OpenSSL must not infer the build machine's Linux ABI for a browser build.
cmake_minimum_required(VERSION 3.24)
function(cme_declare_port)
  cmake_parse_arguments(port "" "NAME" "CONFIGURE_ARGS;CONFIGURE_CROSS" ${ARGN})
  set(selected_target "${port_CONFIGURE_CROSS}" PARENT_SCOPE)
  set(selected_args "${port_CONFIGURE_ARGS}" PARENT_SCOPE)
endfunction()

set(CMAKE_CROSSCOMPILING TRUE)
set(CMAKE_SIZEOF_VOID_P 4)
set(CMAKE_SYSTEM_NAME Emscripten)
set(CMAKE_SYSTEM_PROCESSOR wasm32)
include("${CMAKE_CURRENT_LIST_DIR}/../registry/openssl/port.cmake")
list(GET selected_target 0 target)
if(NOT target STREQUAL "gcc")
  message(FATAL_ERROR "Browser OpenSSL selected ${target}")
endif()
foreach(option no-asm no-dso no-afalgeng)
  if(NOT option IN_LIST selected_args)
    message(FATAL_ERROR "Browser OpenSSL is missing ${option}")
  endif()
endforeach()

set(CMAKE_SYSTEM_NAME Android)
set(CMAKE_SYSTEM_PROCESSOR aarch64)
include("${CMAKE_CURRENT_LIST_DIR}/../registry/openssl/port.cmake")
list(GET selected_target 0 target)
if(NOT target STREQUAL "android-arm64" OR "no-asm" IN_LIST selected_args)
  message(FATAL_ERROR "Browser options leaked into Android: ${selected_target};${selected_args}")
endif()
